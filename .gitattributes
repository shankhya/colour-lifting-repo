# Preserve the distributed checksum bytes on every operating system.
* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Preserve official third-party template bytes and intentional TeX spaces.
# Authored manuscript sources retain the repository's normal whitespace checks.
/manuscript/jabbrv-ltwa-all.ldf -text -whitespace
/manuscript/jabbrv-ltwa-en.ldf -text -whitespace
/manuscript/jabbrv.sty -text -whitespace
/manuscript/optica-article.cls -text -whitespace
/manuscript/opticajnl.bst -text -whitespace
/manuscript/osa-supplemental-document.cls -text -whitespace
/manuscript/styles/opticajournal.sty -text -whitespace
